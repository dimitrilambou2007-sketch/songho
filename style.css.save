* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', Arial, sans-serif;
    min-height: 100vh;
}

/* ARRIÈRE-PLAN AVEC TON IMAGE */
body.light, body.dark {
    background: url('Sans titre.jpeg') no-repeat center center fixed;
    background-size: cover;
}

body.light .app-container {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(3px);
}

body.dark .app-container {
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(3px);
}

/* CONTENEUR */
.app-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 30px;
    border-radius: 40px;
}

/* HEADER */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    padding: 0 20px;
}

.logo {
    text-align: center;
}

.logo i {
    font-size: 50px;
    color: #ff8c00;
}

.logo h1 {
    font-size: 2.2rem;
    background: linear-gradient(135deg, #ff8c00, #ffd700);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.subtitle {
    font-size: 0.75rem;
    opacity: 0.7;
}

.theme-btn {
    background: rgba(0, 0, 0, 0.3);
    border: none;
    padding: 10px 20px;
    border-radius: 30px;
    cursor: pointer;
    color: white;
    font-weight: bold;
}

/* SCORES */
.score-cards {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 50px;
    margin-bottom: 40px;
}

.score-card {
    text-align: center;
    padding: 20px 40px;
    border-radius: 30px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    min-width: 160px;
}

.score-card .avatar i {
    font-size: 40px;
    color: #ffd700;
}

.score-value {
    font-size: 3rem;
    font-weight: bold;
    margin: 10px 0;
    color: #ffd700;
}

.badge {
    font-size: 0.7rem;
    padding: 4px 12px;
    border-radius: 20px;
    background: #ff8c00;
}

.vs {
    font-size: 1.5rem;
    color: white;
    opacity: 0.7;
}

/* PLATEAU */
.game-board {
    display: flex;
    justify-content: center;
    margin-bottom: 30px;
}

#plateau {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 25px;
}

.rangee {
    display: flex;
    gap: 15px;
    margin: 10px 0;
}

.case {
    width: 70px;
    height: 70px;
    background: radial-gradient(circle, #d4a373, #a0683a);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.15s;
    box-shadow: 0 6px 0 #5a3a22;
    color: #2c1a0e;
}

.case:hover {
    transform: scale(1.08);
    background: radial-gradient(circle, #e8b87a, #b5835a);
}

.case.vide {
    opacity: 0.5;
    cursor: not-allowed;
}

/* CONTRÔLES */
.game-controls {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 20px;
}

.turn-indicator {
    background: #ff8c00;
    padding: 12px 28px;
    border-radius: 40px;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 10px;
}

.reset-btn {
    background: #dc3545;
    color: white;
    border: none;
    padding: 12px 28px;
    border-radius: 40px;
    cursor: pointer;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 10px;
}

.reset-btn:hover {
    background: #c82333;
}

.info-message {
    text-align: center;
    margin-top: 20px;
    font-weight: bold;
    color: #ffd700;
    text-shadow: 1px 1px 2px black;
}

/* LOBBY */
.lobby-container {
    max-width: 500px;
    margin: 100px auto;
    text-align: center;
    padding: 40px;
    border-radius: 40px;
    background: rgba(0, 0, 0, 0.7);
}

.lobby-container h1 {
    color: #ffd700;
}

.lobby-container input {
    padding: 14px 20px;
    font-size: 1rem;
    border: none;
    border-radius: 50px;
    width: 250px;
    margin: 10px;
}

.lobby-container button {
    padding: 14px 28px;
    font-size: 1rem;
    border: none;
    border-radius: 50px;
    background: #ff8c00;
    cursor: pointer;
    font-weight: bold;
    margin: 10px;
}

.code-display {
    background: #1a1a2e;
    padding: 20px;
    border-radius: 20px;
    margin: 20px auto;
    color: #ffd700;
    font-size: 32px;
    letter-spacing: 5px;
    display: inline-block;
}

/* CHARGEMENT */
.loader-screen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #1a1a2e;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.loader-content {
    text-align: center;
    color: white;
}

.loader-icon {
    font-size: 60px;
    color: #ffd700;
    animation: pulse 1s infinite;
}

.progress-bar {
    width: 280px;
    height: 8px;
    background: #333;
    border-radius: 10px;
    overflow: hidden;
    margin: 25px auto;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #ffd700, #ff8c00);
    transition: width 0.3s;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

/* RESPONSIVE */
@media (max-width: 700px) {
    .case { width: 50px; height: 50px; font-size: 1rem; }
    .rangee { gap: 8px; }
    .score-card { padding: 12px 20px; min-width: 120px; }
    .score-value { font-size: 2rem; }
}



/* Animation pour le popup */
@keyframes popupAppear {
    from {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.8);
    }
    to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
}
